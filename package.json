{
  "name": "@shiodome47/video-utils",
  "version": "0.1.0",
  "description": "動画まわりの小さな道具: YouTube の動画 ID・Dropbox の共有リンク・安全な URL、mp4 の faststart（iPhone の Safari 対策）、SRT・WebVTT の字幕を読む。計算だけ・依存なし。",
  "keywords": [
    "video",
    "youtube",
    "dropbox",
    "mp4",
    "faststart",
    "moov",
    "subtitles",
    "srt",
    "webvtt",
    "ios",
    "safari"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiodome47/video-utils.git"
  },
  "homepage": "https://github.com/shiodome47/video-utils#readme",
  "bugs": "https://github.com/shiodome47/video-utils/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "vite --config examples/web/vite.config.ts",
    "build:demo": "vite build --config examples/web/vite.config.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
